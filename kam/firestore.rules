rules_version = '2';

// Firestore Security Rules — Mutual Device Presence & Reassurance System.
//
// Design principles (see docs/architecture/FIREBASE_SECURITY.md):
//   1. Default deny. Nothing is readable or writable unless a rule allows it.
//   2. Authentication is identity, never authorization. Being signed in grants
//      access to your own data only.
//   3. Partner data is reachable ONLY through an ACTIVE pair whose owner has
//      explicitly enabled that category and has not paused sharing.
//   4. Location is gated independently of every other category (NFR-036).
//   5. Field-level minimisation is enforced on WRITE (so disabled categories are
//      never stored) and re-checked on READ (so a lingering field cannot become
//      readable after sharing is turned off).
//   6. History and interpretation documents are append-only.
//   7. A user-defined interpretation can only be created with isUserDefined =
//      true, so a configured percentage can never masquerade as a measured one
//      (SRS FR-030, NFR-023, NFR-041).
//   8. There is NO privileged server. The project runs on the Firebase Spark
//      (no-billing) plan, so no Cloud Function and no Admin SDK exists
//      (ADR-009). Every transition a server would have performed is instead
//      made *verifiable* by these rules:
//        * a pair becomes 'active' only when BOTH members' own consent
//          documents are granted (the rules read both, so neither client is
//          trusted to assert the other's agreement);
//        * consents are the authority for sharing, so revoking consent stops
//          partner reads immediately, not just on the next write;
//        * pairing codes are client-generated with a CSPRNG, expire quickly,
//          are single-use, unlistable, and required to create a pair;
//        * notifications are per-user records written by the owner's own
//          device, never injected by anyone else.
//      Rules authorize each write. Client-generated randomness and global
//      duplicate-pair prevention remain limited; see docs/pairing/.
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helpers
    // =====================================================================

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(id) {
      return signedIn() && uid() == id;
    }

    // All categories a user may share. Mirrors SharingCategory in the Flutter
    // domain model; keep the two in sync.
    function validCategories() {
      return [
        'battery',
        'charging',
        'network',
        'location',
        'distanceFromHome',
        'activityIndicators',
        'ruleInterpretations'
      ];
    }

    function pairDoc(pairId) {
      return /databases/$(database)/documents/pairs/$(pairId);
    }

    function pairExists(pairId) {
      return exists(pairDoc(pairId));
    }

    function pairData(pairId) {
      return get(pairDoc(pairId)).data;
    }

    function isMember(pairId) {
      return signedIn()
        && pairExists(pairId)
        && uid() in pairData(pairId).memberIds;
    }

    function isActivePair(pairId) {
      return isMember(pairId)
        && pairData(pairId).status == 'active'
        && bothConsentsGranted(pairId, pairData(pairId).memberIds);
    }

    // Per-pair sharing decision of one member. One document per (pair, user) so
    // there is a single source of truth for "am I sharing this right now".
    function sharingDoc(pairId, ownerId) {
      return /databases/$(database)/documents/pairs/$(pairId)/sharing/$(ownerId);
    }

    function hasSharing(pairId, ownerId) {
      return exists(sharingDoc(pairId, ownerId));
    }

    function sharing(pairId, ownerId) {
      return get(sharingDoc(pairId, ownerId)).data;
    }

    // One member's explicit consent document (FR-005, NFR-003).
    function consentDoc(pairId, ownerId) {
      return /databases/$(database)/documents/pairs/$(pairId)/consents/$(ownerId);
    }

    function consentGranted(pairId, ownerId) {
      return exists(consentDoc(pairId, ownerId))
        && get(consentDoc(pairId, ownerId)).data.granted == true;
    }

    // Both members must independently hold a granted consent. Each consent can
    // only ever be written by its own subject (see the `consents` match block),
    // so this cannot be satisfied by one user on another's behalf.
    function bothConsentsGranted(pairId, memberIds) {
      return consentGranted(pairId, memberIds[0])
        && consentGranted(pairId, memberIds[1]);
    }

    // Consent is the standing authority for sharing, so revoking it stops
    // partner reads on the very next read rather than waiting for the owner to
    // also clear a category (NFR-002, NFR-003).
    function notPaused(pairId, ownerId) {
      return hasSharing(pairId, ownerId)
        && sharing(pairId, ownerId).paused == false
        && consentGranted(pairId, ownerId);
    }

    function shares(pairId, ownerId, category) {
      return hasSharing(pairId, ownerId) && category in sharing(pairId, ownerId).categories;
    }

    // May the caller currently read one shared category of another member?
    function canReadShared(pairId, ownerId, category) {
      return isActivePair(pairId) && notPaused(pairId, ownerId) && shares(pairId, ownerId, category);
    }

    // The exact field set a device-state document may contain (Phase 11 §37).
    // Writing anything else is rejected, so a modified client cannot smuggle
    // extra data into a shared document or add a field the reader would trust.
    function deviceStateKeys() {
      return [
        'ownerUserId', 'deviceId', 'schemaVersion', 'stateVersion',
        'observedAt', 'updatedAt', 'availabilityState', 'lastOnlineAt',
        'batteryPercentage', 'isCharging', 'chargingStartedAt',
        'chargingDurationSeconds', 'networkState', 'screenState',
        'activityState', 'lastActivityAt'
      ];
    }

    function locationKeys() {
      return [
        'ownerUserId', 'deviceId', 'schemaVersion', 'stateVersion',
        'observedAt', 'updatedAt', 'latitude', 'longitude',
        'accuracyMeters', 'approximate', 'distanceFromHomeKm', 'homePresence'
      ];
    }

    // Availability names a capability may legitimately be reported as.
    function availabilityNames() {
      return [
        'available', 'unavailable', 'unknown', 'unsupported',
        'permissionDenied', 'serviceDisabled', 'error', 'stale'
      ];
    }

    // An enum-ish field may carry a real value or an availability marker, so a
    // capability the device cannot observe stays `unsupported` across
    // synchronization instead of silently becoming `off` (Phase 11 §41).
    function screenStateValues() {
      return ['on', 'off', 'unknown', 'unavailable', 'unsupported',
              'permissionDenied', 'serviceDisabled', 'error', 'stale'];
    }

    function activityStateValues() {
      return ['activityDetected', 'noActivityObserved', 'unknown',
              'unavailable', 'unsupported', 'permissionDenied',
              'serviceDisabled', 'error', 'stale'];
    }

    function homePresenceValues() {
      return ['atHome', 'nearHome', 'awayFromHome', 'stale', 'unsupported', 'unknown'];
    }

    // A device observation must be a real timestamp and may not be further in
    // the future than normal clock skew allows (Phase 11 §37).
    function validObservedAt() {
      return request.resource.data.observedAt is timestamp
        && request.resource.data.observedAt <= request.time + duration.value(5, 'm');
    }

    // The categories the owner shares right now, read once per request.
    function sharingCategories(pairId, ownerId) {
      return hasSharing(pairId, ownerId) ? sharing(pairId, ownerId).categories : [];
    }

    // Field-level minimisation on READ: every present field must still be shared.
    //
    // `keys` is passed in by the caller so the key list is built once per
    // request instead of once per field. Firestore caps a request at 1000
    // expression evaluations, and the naive per-field form of this check was
    // enough to reach that cap on writes.
    function stateFieldsStillShared(pairId, ownerId, keys) {
      return (!keys.hasAny(['batteryPercentage']) || shares(pairId, ownerId, 'battery'))
        && (!keys.hasAny(['isCharging', 'chargingStartedAt', 'chargingDurationSeconds'])
            || shares(pairId, ownerId, 'charging'))
        && (!keys.hasAny(['networkState']) || shares(pairId, ownerId, 'network'))
        && (!keys.hasAny(['screenState', 'activityState', 'lastActivityAt'])
            || shares(pairId, ownerId, 'activityIndicators'));
    }

    function locationFieldsStillShared(pairId, ownerId, keys) {
      return (!keys.hasAny(['latitude', 'longitude', 'accuracyMeters', 'approximate'])
            || shares(pairId, ownerId, 'location'))
        && (!keys.hasAny(['distanceFromHomeKm', 'homePresence'])
            || shares(pairId, ownerId, 'distanceFromHome'));
    }

    // Everything a device-state write must satisfy, in one place.
    //
    // Two independent guarantees live here: a gated field may only be present at
    // all if its category is shared right now (so a disabled category is never
    // stored), and every value is range- and type-checked before storage (so a
    // reader can never be handed something it could not interpret).
    function deviceStateWriteValid(keys, categories) {
      return keys.hasOnly(deviceStateKeys())
        && (!keys.hasAny(['batteryPercentage']) || 'battery' in categories)
        && (!keys.hasAny(['isCharging', 'chargingStartedAt', 'chargingDurationSeconds'])
            || 'charging' in categories)
        && (!keys.hasAny(['networkState']) || 'network' in categories)
        && (!keys.hasAny(['screenState', 'activityState', 'lastActivityAt'])
            || 'activityIndicators' in categories)
        && (!keys.hasAny(['batteryPercentage'])
            || (request.resource.data.batteryPercentage is int
                && request.resource.data.batteryPercentage >= 0
                && request.resource.data.batteryPercentage <= 100))
        && (!keys.hasAny(['isCharging']) || request.resource.data.isCharging is bool)
        && (!keys.hasAny(['chargingDurationSeconds'])
            || (request.resource.data.chargingDurationSeconds is int
                && request.resource.data.chargingDurationSeconds >= 0))
        && (!keys.hasAny(['chargingStartedAt'])
            || request.resource.data.chargingStartedAt is timestamp)
        && (!keys.hasAny(['networkState'])
            || request.resource.data.networkState in ['online', 'offline', 'unknown'])
        && (!keys.hasAny(['screenState'])
            || request.resource.data.screenState in screenStateValues())
        && (!keys.hasAny(['activityState'])
            || request.resource.data.activityState in activityStateValues())
        && (!keys.hasAny(['availabilityState'])
            || request.resource.data.availabilityState in availabilityNames())
        && (!keys.hasAny(['observedAt']) || validObservedAt())
        && (!keys.hasAny(['lastActivityAt'])
            || request.resource.data.lastActivityAt is timestamp)
        && (!keys.hasAny(['lastOnlineAt'])
            || request.resource.data.lastOnlineAt is timestamp)
        && (!keys.hasAny(['deviceId'])
            || (request.resource.data.deviceId is string
                && request.resource.data.deviceId.size() <= 64))
        && (!keys.hasAny(['schemaVersion']) || request.resource.data.schemaVersion == 1);
    }

    function locationWriteValid(keys, categories) {
      return keys.hasOnly(locationKeys())
        && (!keys.hasAny(['latitude', 'longitude', 'accuracyMeters', 'approximate'])
            || 'location' in categories)
        && (!keys.hasAny(['distanceFromHomeKm', 'homePresence'])
            || 'distanceFromHome' in categories)
        && (!keys.hasAny(['observedAt']) || validObservedAt())
        && (!keys.hasAny(['latitude'])
            || (request.resource.data.latitude is number
                && request.resource.data.latitude >= -90
                && request.resource.data.latitude <= 90))
        && (!keys.hasAny(['longitude'])
            || (request.resource.data.longitude is number
                && request.resource.data.longitude >= -180
                && request.resource.data.longitude <= 180))
        && (!keys.hasAny(['accuracyMeters'])
            || (request.resource.data.accuracyMeters is number
                && request.resource.data.accuracyMeters >= 0))
        && (!keys.hasAny(['approximate']) || request.resource.data.approximate is bool)
        && (!keys.hasAny(['distanceFromHomeKm'])
            || (request.resource.data.distanceFromHomeKm is number
                && request.resource.data.distanceFromHomeKm >= 0))
        && (!keys.hasAny(['homePresence'])
            || request.resource.data.homePresence in homePresenceValues())
        && (!keys.hasAny(['schemaVersion']) || request.resource.data.schemaVersion == 1);
    }

    // An older local snapshot must not overwrite a newer one (Phase 11 §49).
    function versionNotRegressing() {
      return resource == null
        || !('stateVersion' in request.resource.data.keys())
        || !('stateVersion' in resource.data.keys())
        || request.resource.data.stateVersion >= resource.data.stateVersion;
    }

    // =====================================================================
    // users/{uid}
    //   Owner-only profile and settings. A partner NEVER reads this document;
    //   the partner-visible display name lives in pairs/{pairId}/members/{uid}.
    //   Home coordinates therefore stay private and the partner only ever sees
    //   the derived distance written into the shared state.
    // =====================================================================
    match /users/{userId} {

      allow read: if isSelf(userId);

      // Creation is key-validated and the timestamps must be the server's, so a
      // client cannot backdate its own profile (FIRESTORE_DATA_MODEL §7).
      allow create: if isSelf(userId)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.keys().hasOnly([
             'displayName', 'photoUrl', 'timeZone', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Ownership and creation time are immutable, and the change must be
      // timestamped by the server.
      allow update: if isSelf(userId)
        && request.resource.data.keys().hasOnly([
             'displayName', 'photoUrl', 'timeZone', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.createdAt == resource.data.createdAt
        && (
             ('activatedAt' in resource.data.keys()
               && request.resource.data.activatedAt == resource.data.activatedAt)
             || (!('activatedAt' in resource.data.keys())
               && (
                    !('activatedAt' in request.resource.data.keys())
                    || (request.resource.data.status == 'active'
                      && request.resource.data.activatedAt == request.time)
                  ))
           )
        && request.resource.data.updatedAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120;

      // Data deletion is a user right (NFR-032); deeper retention policy is
      // handled server-side in a later phase.
      allow delete: if isSelf(userId);

      // Private settings: home location, notification preference. Never shared.
      //
      // Key-validated rather than write-anything: the home coordinates here are
      // the most sensitive field the owner stores (NFR-005, NFR-036), so the
      // shape is constrained and the coordinate ranges are checked.
      match /settings/{documentId} {
        allow read: if isSelf(userId) && documentId == 'preferences';

        allow write: if isSelf(userId) && documentId == 'preferences'
          && request.resource.data.keys().hasOnly([
               'notificationPreference', 'homeLocation', 'updatedAt'
             ])
          && request.resource.data.updatedAt == request.time
          && (
            !('notificationPreference' in request.resource.data)
            || request.resource.data.notificationPreference in [
                 'allRuleNotifications', 'importantOnly',
                 'specificRulesOnly', 'noNotifications'
               ]
          )
          && (
            !('homeLocation' in request.resource.data)
            || (
              request.resource.data.homeLocation.latitude is number
              && request.resource.data.homeLocation.latitude >= -90
              && request.resource.data.homeLocation.latitude <= 90
              && request.resource.data.homeLocation.longitude is number
              && request.resource.data.homeLocation.longitude >= -180
              && request.resource.data.homeLocation.longitude <= 180
            )
          );
      }

      // Rule definitions are private to their owner. The partner only ever sees
      // the interpretations a rule produces (Phase 14).
      //
      // The owner is bound to the path and the stored `ownerUserId`, and the
      // allowed field set is closed, so a modified client cannot smuggle extra
      // data into a rule document or write a rule for somebody else. The
      // condition shape is type-checked so a reader is never handed something it
      // could not interpret; semantic validation lives in the Dart domain layer,
      // which is the layer that authors these documents.
      match /rules/{ruleId} {
        function ruleKeys() {
          return [
            'ownerUserId', 'pairId', 'name', 'version', 'enabled',
            'allowStaleData', 'cooldownSeconds', 'condition', 'conditionGroup',
            'actions', 'lastTriggeredAt', 'createdAt', 'updatedAt',
            'schemaVersion'
          ];
        }

        // A condition must at least name a metric and an operator. Deeper
        // validation would duplicate the Dart domain model without adding a
        // security guarantee, because a malformed rule grants no access.
        function conditionValid(condition) {
          return condition is map
            && condition.metric is string
            && condition.operator is string
            && (!('stateValue' in condition) || condition.stateValue is string)
            && (!('numericThreshold' in condition) || condition.numericThreshold is number)
            && (!('durationSeconds' in condition) || condition.durationSeconds is int);
        }

        function ruleValid() {
          return request.resource.data.ownerUserId == userId
            && request.resource.data.pairId is string
            && request.resource.data.pairId.size() > 0
            && request.resource.data.pairId.size() <= 128
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 120
            && request.resource.data.version is int
            && request.resource.data.version >= 1
            && request.resource.data.enabled is bool
            && (!('allowStaleData' in request.resource.data)
                || request.resource.data.allowStaleData is bool)
            && request.resource.data.cooldownSeconds is int
            && request.resource.data.cooldownSeconds >= 0
            && conditionValid(request.resource.data.condition)
            && (!('conditionGroup' in request.resource.data)
                || request.resource.data.conditionGroup is map)
            && request.resource.data.actions is list
            // A user-configured percentage must never be stored as if measured.
            && request.resource.data.actions.size() <= 8
            && request.resource.data.schemaVersion == 1
            && (
              (request.resource.data.type in ['chargingStarted', 'chargingStopped']
                && request.resource.data.category == 'charging')
              || (request.resource.data.type in ['deviceWentOffline', 'deviceCameOnline', 'connectionChanged']
                && request.resource.data.category == 'network')
              || (request.resource.data.type == 'locationChangedSignificantly'
                && request.resource.data.category == 'location')
              || (request.resource.data.type in ['ruleActivated', 'ruleDeactivated', 'ruleBecameUnknown', 'interpretationGenerated']
                && request.resource.data.category == 'rules')
              || (request.resource.data.type in ['ruleNotificationGenerated', 'notificationSuppressed']
                && request.resource.data.category == 'notifications')
              || (request.resource.data.type == 'sharingPermissionChanged'
                && request.resource.data.category == 'device')
            )
            && request.resource.data.keys().hasOnly(ruleKeys());
        }

        allow read, delete: if isSelf(userId);

        allow create: if isSelf(userId)
          && ruleValid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // The creation time is immutable, so an edit cannot rewrite history.
        allow update: if isSelf(userId)
          && ruleValid()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
      }

      // Push tokens. Owner-only: a token is never readable by a partner.
      match /fcmTokens/{tokenId} {
        allow read, write: if isSelf(userId);
      }

      // Notifications for this user.
      //
      // Under Spark there is no server, so these records are written by the
      // OWNER'S OWN DEVICE when its local rule engine observes authorized
      // partner state and decides a rule should notify (ADR-009). That is safe
      // because the collection is strictly per-user: `isSelf(userId)` is
      // required for every write, so no user can inject or alter content in
      // another person's notification centre. Content is bounded, and the
      // identity/creation fields are immutable after creation.
      match /notifications/{notificationId} {
        allow read: if isSelf(userId);

        allow create: if isSelf(userId)
          && request.resource.data.recipientUserId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 500
          && request.resource.data.category in [
               'ruleInterpretation', 'deviceStateChange',
               'connectionChange', 'sharingChange', 'system'
             ]
          && request.resource.data.read == false
          && request.resource.data.delivered == false
          && request.resource.data.createdAt == request.time;

        // Only the delivery/read flags may change, so a notification record
        // cannot be rewritten into a different message after the fact.
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['read', 'delivered'])
          && request.resource.data.title == resource.data.title
          && request.resource.data.body == resource.data.body
          && request.resource.data.createdAt == resource.data.createdAt;

        // The owner may clear their own history; nobody else can (NFR-032).
        allow delete: if isSelf(userId);
      }
    }

    // =====================================================================
    // pairingCodes/{code} — client-issued connection codes (FR-003, FR-004).
    //
    // ADR-002 originally reserved code issuance for a Cloud Function because a
    // Rules enforce length, expiry and single-use. Randomness comes from the
    // shipped client's CSPRNG; rules cannot prove entropy or rate-limit guesses.
    //   * expiring  — the code must carry a future expiry no more than 1h away,
    //     and every `get`/`update` re-checks it.
    //   * single-use — redemption may only set `usedByUserId` once, from null.
    //
    // A code is a discovery mechanism only: possessing it grants NO access to
    // device data (FR-003). Only consent plus sharing categories do that.
    match /pairingCodes/{code} {

      // Redeemable lookup: a signed-in user may fetch a specific code document
      // while it is live. `list` is denied, so outstanding codes cannot be
      // harvested — guessing a 20+ character code is infeasible.
      allow get: if signedIn() && resource.data.expiresAt > request.time
        && resource.data.revoked == false && resource.data.status == 'created'
        && resource.data.usedByUserId == null;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.createdByUserId == uid()
        && request.resource.data.code == code
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 20
        && request.resource.data.code.size() <= 64
        && request.resource.data.revoked == false
        && request.resource.data.status == 'created'
        && request.resource.data.usedByUserId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(1, 'h');

      // Single use: only a live, unused, unrevoked code can be consumed, the
      // consumer must be the caller, and consumption may change nothing else.
      allow update: if signedIn() && resource.data.expiresAt > request.time
        && (
          (resource.data.usedByUserId == null
            && resource.data.revoked == false
            && resource.data.status == 'created'
            && request.resource.data.usedByUserId == uid()
            && request.resource.data.usedAt == request.time
            && request.resource.data.status == 'consumed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedByUserId', 'usedAt', 'status']))
          ||
          (resource.data.createdByUserId == uid()
            && resource.data.usedByUserId == null
            && resource.data.revoked == false
            && resource.data.status == 'created'
            && request.resource.data.revoked == true
            && request.resource.data.status == 'cancelled'
            && request.resource.data.revokedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt', 'status']))
        );

      // The issuer may withdraw their own code (a redeemed one stays for audit).
      allow delete: if false;
    }

    // =====================================================================
    // pairs/{pairId} — the central security boundary.
    // =====================================================================
    match /pairs/{pairId} {

      // Members can read the pair they belong to. `resource.data` is used
      // directly (no extra get()); list queries are only permitted when they
      // filter on memberIds.
      allow read: if signedIn() && uid() in resource.data.memberIds;

      // A connection request is bound to an atomically consumed invitation.
      allow create: if signedIn()
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && uid() in request.resource.data.memberIds
        && request.resource.data.memberIds[0] != request.resource.data.memberIds[1]
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == uid()
        && request.resource.data.invitationCode is string
        && existsAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.invitationCode))
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.invitationCode)).data.usedByUserId == uid()
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.invitationCode)).data.status == 'consumed'
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.invitationCode)).data.createdByUserId in request.resource.data.memberIds
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.invitationCode)).data.expiresAt > request.time
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.invitationCode)).data.revoked == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.schemaVersion == 1
        && request.resource.data.keys().hasOnly([
             'memberIds', 'status', 'requestedBy', 'createdAt', 'updatedAt',
             'invitationCode', 'schemaVersion'
           ]);

      // Membership is immutable. A member may never grant themselves access to
      // another person's data; the only forward transition is activation, and it
      // is permitted solely when BOTH consent documents are already granted.
      //
      // Both consents are required. Spark cannot provide a global uniqueness
      // index for arbitrary pair IDs; see docs/pairing/PAIRING_SYSTEM.md.
      allow update: if isMember(pairId)
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.invitationCode == resource.data.invitationCode
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
             'memberIds', 'status', 'requestedBy', 'createdAt', 'updatedAt',
             'invitationCode', 'schemaVersion', 'activatedAt', 'endedAt'
           ])
        && request.resource.data.status is string
        && (
             // No-op status write (for example touching updatedAt).
             request.resource.data.status == resource.data.status
             && (
                  ('endedAt' in resource.data.keys()
                    && request.resource.data.endedAt == resource.data.endedAt)
                  || (!('endedAt' in resource.data.keys())
                    && !('endedAt' in request.resource.data.keys()))
                )
             // Activation, or resuming a paused pair, once both users agreed.
             || (
                  resource.data.status in ['pending', 'paused']
                  && request.resource.data.status == 'active'
                  && resource.data.memberIds.size() == 2
                  && (!('activatedAt' in resource.data.keys()) || request.resource.data.activatedAt == resource.data.activatedAt)
                  && request.resource.data.activatedAt == request.time
                  && bothConsentsGranted(pairId, resource.data.memberIds)
                )
             // Ending the relationship is always available to a member.
             || (
                  resource.data.status in ['pending', 'active', 'paused']
                  && request.resource.data.status in ['disconnected', 'revoked']
                  && request.resource.data.endedAt == request.time
                )
           );

      // Pairs are ended, not deleted, so history stays auditable.
      allow delete: if false;

      // --- pair-scoped member profile (the partner-visible name/photo) ------
      match /members/{memberId} {
        allow read: if isMember(pairId);

        allow create: if isMember(pairId)
          && isSelf(memberId)
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 120;

        allow update: if isMember(pairId)
          && isSelf(memberId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'displayName', 'photoUrl'
             ]);

        allow delete: if false;
      }

      // --- explicit consent per user ---------------------------------------
      // Pairing is not authorization: each user records their own decision.
      match /consents/{consentId} {
        allow read: if isMember(pairId);

        allow create: if isMember(pairId)
          && isSelf(consentId)
          && request.resource.data.userId == consentId
          && request.resource.data.pairId == pairId
          && request.resource.data.granted is bool
          && request.resource.data.categories is list
          && request.resource.data.categories.hasOnly(validCategories())
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.granted == false || request.resource.data.grantedAt == request.time);

        allow update: if isMember(pairId)
          && isSelf(consentId)
          && resource.data.granted == true
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.pairId == resource.data.pairId
          && request.resource.data.grantedAt == resource.data.grantedAt
          && request.resource.data.categories == resource.data.categories
          && request.resource.data.categories.hasOnly(validCategories())
          && request.resource.data.granted is bool
          && request.resource.data.grantedAt == resource.data.grantedAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isMember(pairId) && isSelf(consentId);
      }

      // --- live sharing switches -------------------------------------------
      // Enforced on every partner read, so disabling a category takes effect
      // immediately and cannot be bypassed by a modified client.
      match /sharing/{sharingId} {
        allow read: if isMember(pairId);

        allow create, update: if isMember(pairId)
          && isSelf(sharingId)
          && request.resource.data.userId == sharingId
          && request.resource.data.pairId == pairId
          && request.resource.data.paused is bool
          && request.resource.data.categories is list
          && request.resource.data.categories.hasOnly(validCategories());

        allow delete: if false;
      }

      // --- registered devices ----------------------------------------------
      match /devices/{deviceId} {
        allow read: if isMember(pairId);

        allow create, update: if isMember(pairId)
          && request.resource.data.ownerUserId == uid()
          && request.resource.data.deviceId == deviceId
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.lastSeenAt is timestamp;

        allow delete: if isMember(pairId)
          && resource.data.ownerUserId == uid();
      }

      // --- current device state (non-location) -----------------------------
      // One document per (pair, owner). Writes are validated field by field so a
      // disabled category is never stored; reads re-check so a lingering field
      // cannot become visible after sharing is switched off.
      match /deviceState/{ownerId} {
        // One owner, one document: the path, the authenticated identity and the
        // stored owner must all agree, so a forged `userId` (or `deviceId`,
        // which is never authorization evidence) changes nothing.
        function ownerWritesOwnState() {
          return isSelf(ownerId)
            && isActivePair(pairId)
            && request.resource.data.ownerUserId == uid()
            && request.resource.data.updatedAt == request.time
            && notPaused(pairId, ownerId)
            && deviceStateWriteValid(
                 request.resource.data.keys(),
                 sharingCategories(pairId, ownerId)
               )
            && versionNotRegressing();
        }

        allow read: if isSelf(ownerId)
          || (
               isActivePair(pairId)
               && notPaused(pairId, ownerId)
               && (
                    shares(pairId, ownerId, 'battery')
                    || shares(pairId, ownerId, 'charging')
                    || shares(pairId, ownerId, 'network')
                    || shares(pairId, ownerId, 'activityIndicators')
                  )
               && stateFieldsStillShared(pairId, ownerId, resource.data.keys())
             );

        allow create, update: if ownerWritesOwnState();

        // A paused owner can still remove their own state document.
        allow delete: if isSelf(ownerId);
      }

      // --- location: independently gated (NFR-036) -------------------------
      match /location/{ownerId} {
        allow read: if isSelf(ownerId)
          || (
               canReadShared(pairId, ownerId, 'location')
               && locationFieldsStillShared(pairId, ownerId, resource.data.keys())
             );

        allow create, update: if isSelf(ownerId)
          && isActivePair(pairId)
          && request.resource.data.ownerUserId == uid()
          && request.resource.data.updatedAt == request.time
          && notPaused(pairId, ownerId)
          && locationWriteValid(
               request.resource.data.keys(),
               sharingCategories(pairId, ownerId)
             )
          && versionNotRegressing();

        allow delete: if isSelf(ownerId);
      }

      // --- rule interpretations --------------------------------------------
      // Append-only, and always flagged as user-defined: a configured
      // percentage can never be stored as a measured one.
      match /interpretations/{interpretationId} {
        allow read: if isMember(pairId)
          && (
               resource.data.ownerUserId == uid()
               || (
                    isActivePair(pairId)
                    && notPaused(pairId, resource.data.ownerUserId)
                    && shares(pairId, resource.data.ownerUserId, 'ruleInterpretations')
                  )
             );

        allow create: if isActivePair(pairId)
          && request.resource.data.ownerUserId == uid()
          && request.resource.data.isUserDefined == true
          && notPaused(pairId, uid())
          && shares(pairId, uid(), 'ruleInterpretations');

        allow update, delete: if false;
      }

      // --- meaningful events (history) -------------------------------------
      // A member may create events for their own device only, and must use a
      // server timestamp. Records cannot be rewritten; owners may delete their
      // own events as a privacy control.
      match /events/{eventId} {
        function validEvent() {
          return request.resource.data.keys().hasOnly([
              'ownerUserId', 'type', 'category', 'occurredAt', 'recordedAt',
              'observedAt', 'source', 'deduplicationKey', 'summary',
              'payload', 'schemaVersion'
            ])
            && request.resource.data.ownerUserId == uid()
            && request.resource.data.type in [
              'chargingStarted', 'chargingStopped', 'deviceWentOffline',
              'deviceCameOnline', 'locationChangedSignificantly',
              'ruleActivated', 'ruleDeactivated', 'ruleBecameUnknown',
              'ruleNotificationGenerated', 'connectionChanged',
              'sharingPermissionChanged', 'interpretationGenerated',
              'notificationSuppressed'
            ]
            && request.resource.data.category in [
              'device', 'network', 'location', 'charging', 'rules', 'notifications'
            ]
            && request.resource.data.occurredAt is timestamp
            && request.resource.data.occurredAt <= request.time + duration.value(5, 'm')
            && request.resource.data.recordedAt == request.time
            && request.resource.data.source in ['device', 'rule', 'notification']
            && request.resource.data.schemaVersion == 1
            && (!('observedAt' in request.resource.data) || request.resource.data.observedAt is timestamp)
            && (!('deduplicationKey' in request.resource.data)
                || (request.resource.data.deduplicationKey is string
                    && request.resource.data.deduplicationKey.size() <= 128))
            && (!('summary' in request.resource.data)
                || (request.resource.data.summary is string
                    && request.resource.data.summary.size() <= 120))
            && (!('payload' in request.resource.data)
                || (request.resource.data.payload is map
                    && request.resource.data.payload.keys().hasOnly(['transition', 'ruleVersion', 'outcome'])
                    && request.resource.data.payload.size() <= 3
                    && (!('transition' in request.resource.data.payload)
                        || (request.resource.data.payload.transition is string
                            && request.resource.data.payload.transition.size() <= 64))
                    && (!('ruleVersion' in request.resource.data.payload)
                        || (request.resource.data.payload.ruleVersion is int
                            && request.resource.data.payload.ruleVersion > 0))
                    && (!('outcome' in request.resource.data.payload)
                        || (request.resource.data.payload.outcome is string
                            && request.resource.data.payload.outcome.size() <= 40))));
        }

        // Event reads stop when mutual consent/active pairing ends. A member
        // may still remove their own records after a pair has ended.
        allow read: if isMember(pairId)
          && (resource.data.ownerUserId == uid() || isActivePair(pairId));

        allow create: if isActivePair(pairId)
          && notPaused(pairId, uid())
          && validEvent()
          && (
            (request.resource.data.category == 'charging'
              && shares(pairId, uid(), 'charging'))
            || (request.resource.data.category == 'network'
              && shares(pairId, uid(), 'network'))
            || (request.resource.data.category == 'location'
              && shares(pairId, uid(), 'location'))
            || (request.resource.data.category == 'rules'
              && shares(pairId, uid(), 'ruleInterpretations'))
            || (request.resource.data.category == 'notifications'
              && shares(pairId, uid(), 'ruleInterpretations'))
          );

        allow delete: if isMember(pairId) && resource.data.ownerUserId == uid();
        allow update: if false;
      }
    }

    // Everything not matched above is denied by default.
  }
}
