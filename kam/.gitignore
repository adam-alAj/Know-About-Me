*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets and environment files (SRS NFR-029). Defence in depth: server-side
# credentials must never enter this repository.
*.env
*.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
service-account*.json
*serviceAccount*.json
secrets.json

# Firebase / Node tooling (rules tests, emulator artefacts).
# Client Firebase configuration is supplied via --dart-define, so these files
# are never required in the repository. If a real project is configured later and
# google-services.json is committed, remove the matching line deliberately.
node_modules/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
.firebase/
firestore.rules.test.coverage/
android/app/google-services.json
auth_export.json
firestore_export/


