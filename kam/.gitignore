# Secrets and environment files (SRS NFR-029). Defence in depth: server-side
# credentials must never enter this repository.
*.env
*.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local
*.pem
*.p12
*.jks
*.keystore
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
credentials*.json
secrets*.json

# Firebase / Node tooling (rules tests, emulator artefacts).
# Firebase client config (google-services.json) contains public app identifiers,
# not server credentials. Keep local copies out of Git to avoid scanner noise;
# firebase_options.dart is the app's checked-in runtime configuration.
node_modules/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
.firebase/
firestore.rules.test.coverage/
**/google-services*.json
auth_export.json
firestore_export/


